# ========================================
# IT-RE:SOURCE — Environment Configuration
# ========================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ── Security ─────────────────────────────
# Generate a random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-256-bit-key

# ── Database ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ── Service-to-Service Auth ──────────────
# Used to protect /internal/* endpoints from external access.
INTERNAL_SERVICE_TOKEN=change-me-random-service-token

# Shared secret between content_service and search_service for index sync.
SEARCH_INDEX_SECRET=change-me-random-search-secret

# ── CORS ─────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── AI / RAG ─────────────────────────────
# Semantic search / Chroma embeddings (OpenRouter /v1/embeddings).
OPENROUTER_API_KEY=
# RAG & content LLM: OpenAI-compatible API (e.g. Pollinations). If set, used instead of OpenRouter for chat.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://gen.pollinations.ai/v1
OPENAI_MODEL=openai
# If OPENAI_API_KEY is empty, LLM falls back to OpenRouter with:
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
HUGGINGFACE_API_KEY=

# RAG / LLM speed (search_service): lower = faster, shorter answers.
# LLM_MAX_TOKENS=512
# LLM_TEMPERATURE=0.5
# RAG_CHUNK_LIMIT=8
# RAG_MAX_CHUNK_CHARS=900

# ── Optional overrides ───────────────────
# AUTH_SERVICE_URL=http://auth_service:8000
# EMBEDDING_MODEL=openai/text-embedding-3-small
