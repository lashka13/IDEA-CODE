# ========================================
# IT-RE:SOURCE — Environment Configuration
# ========================================
# Copy this file to .env and fill in the values.
# cp .env.example .env

# ── Security ─────────────────────────────
# Generate a random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-256-bit-key

# ── Database ─────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password

# ── Service-to-Service Auth ──────────────
# Used to protect /internal/* endpoints from external access.
INTERNAL_SERVICE_TOKEN=change-me-random-service-token

# Shared secret between content_service and search_service for index sync.
SEARCH_INDEX_SECRET=change-me-random-search-secret

# ── CORS ─────────────────────────────────
# Comma-separated list of allowed origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# ── AI / RAG ─────────────────────────────
# Required for semantic search embeddings (OpenRouter /v1/embeddings).
OPENROUTER_API_KEY=
# Optional fallback LLM provider.
HUGGINGFACE_API_KEY=

# ── Optional overrides ───────────────────
# AUTH_SERVICE_URL=http://auth_service:8000
# EMBEDDING_MODEL=openai/text-embedding-3-small
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
