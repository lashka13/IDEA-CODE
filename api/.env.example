# Database (don't change if using Docker Compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ideacode

# JWT
SECRET_KEY=super-secret-key-change-in-production

# -----------------------------------------------------------------------
# OpenRouter — LLM for AI chat (RAG)
# Get key: https://openrouter.ai/keys
# -----------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-...

# Model to use. Free options:
#   meta-llama/llama-3.1-8b-instruct:free
#   mistralai/mistral-7b-instruct:free
# Paid (better quality):
#   google/gemini-flash-1.5
#   deepseek/deepseek-chat
#   openai/gpt-4o-mini
OPENROUTER_MODEL=google/gemini-flash-1.5

# -----------------------------------------------------------------------
# Embeddings — runs locally (no key needed)
# Model is downloaded automatically on first start (~470 MB)
# -----------------------------------------------------------------------
USE_LOCAL_EMBEDDINGS=True
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ChromaDB path (relative to api/ directory inside Docker)
CHROMA_DB_PATH=./chroma_db
